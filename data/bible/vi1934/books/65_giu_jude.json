{
  "order": 65,
  "code": "giu",
  "osis": "Jude",
  "name_vi": "Giu-đe",
  "name_en": "Jude",
  "testament": "NT",
  "chapter_count": 1,
  "total_verses": 25,
  "chapters": [
    {
      "chapter": 1,
      "total_verses": 25,
      "verses": [
        {
          "global_id": 30652,
          "verse_code": 65001001,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 1,
          "section_title": "Lời đạt và chào thăm",
          "text": "Giu-đe, tôi tớ của Đức Chúa Jêsus Christ và em Gia-cơ, đạt cho những kẻ đã được kêu gọi, được Đức Chúa Trời, là Cha, yêu thương, và được Đức Chúa Jêsus Christ giữ gìn:",
          "cross_references": [
            "Mat 13:55",
            "Mac 6:3"
          ]
        },
        {
          "global_id": 30653,
          "verse_code": 65001002,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 2,
          "section_title": "Lời đạt và chào thăm",
          "text": "nguyền xin sự thương xót, bình an, yêu mến thêm lên cho anh em!",
          "cross_references": []
        },
        {
          "global_id": 30654,
          "verse_code": 65001003,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 3,
          "section_title": "Đạo giả và thầy dối",
          "text": "Hỡi kẻ rất yêu dấu, vì tôi đã ân cần viết cho anh em về sự cứu rỗi chung của chúng ta, tôi tưởng phải làm điều đó, để khuyên anh em vì đạo mà tranh chiến, là đạo đã truyền cho các thánh một lần đủ rồi.",
          "cross_references": []
        },
        {
          "global_id": 30655,
          "verse_code": 65001004,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 4,
          "section_title": "Đạo giả và thầy dối",
          "text": "Vì có mấy kẻ kia lẻn vào trong vòng chúng ta, là những kẻ bị định đoán phạt từ lâu rồi, kẻ chẳng tin kính đổi ơn Đức Chúa Trời chúng ta ra việc tà ác, chối Đấng Chủ tể và Chúa có một của chúng ta, là Đức Chúa Jêsus Christ.",
          "cross_references": [
            "Xem chú thích ở Lu 2:40"
          ]
        },
        {
          "global_id": 30656,
          "verse_code": 65001005,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 5,
          "section_title": "Đạo giả và thầy dối",
          "text": "Dầu anh em đã học những điều nầy rồi, tôi cũng muốn nhắc lại cho anh em rằng, xưa kia Chúa giải cứu dân mình ra khỏi xứ Ê-díp-tô, sau lại tiêu diệt những kẻ không tin;",
          "cross_references": [
            "Xu 12:51",
            "Dan 14:29-30"
          ]
        },
        {
          "global_id": 30657,
          "verse_code": 65001006,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 6,
          "section_title": "Đạo giả và thầy dối",
          "text": "còn các thiên sứ không giữ thứ bậc và bỏ chỗ riêng mình, thì Ngài đã dùng dây xích họ trong nơi tối tăm đời đời, cầm giữ lại để chờ sự phán xét ngày lớn.",
          "cross_references": []
        },
        {
          "global_id": 30658,
          "verse_code": 65001007,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 7,
          "section_title": "Đạo giả và thầy dối",
          "text": "Lại như thành Sô-đôm và Gô-mô-rơ cùng các thành lân cận cũng buông theo sự dâm dục và sắc lạ, thì đã chịu hình phạt bằng lửa đời đời, làm gương để trước mặt chúng ta.",
          "cross_references": [
            "Sa 19:1-24"
          ]
        },
        {
          "global_id": 30659,
          "verse_code": 65001008,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 8,
          "section_title": "Đạo giả và thầy dối",
          "text": "Nhưng mà chúng nó cũng như vậy, trong giấc mơ màng làm ô uế xác thịt mình, khinh dể quyền phép rất cao và nói hỗn các đấng tôn trọng.",
          "cross_references": []
        },
        {
          "global_id": 30660,
          "verse_code": 65001009,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 9,
          "section_title": "Đạo giả và thầy dối",
          "text": "Vả, khi chính mình thiên sứ trưởng Mi-chen chống với ma quỉ giành xác Môi-se, còn chẳng dám lấy lời nhiếc móc mà đoán phạt; người chỉ nói rằng: Cầu Chúa phạt ngươi!",
          "cross_references": [
            "Da 10:13,21",
            "12:1",
            "Kh 12:7",
            "Phu 34:6",
            "Xa 3:2"
          ]
        },
        {
          "global_id": 30661,
          "verse_code": 65001010,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 10,
          "section_title": "Đạo giả và thầy dối",
          "text": "Song những kẻ nầy, hễ điều gì không biết thì khinh dể hết; và mọi điều chúng nó tự nhiên mà biết cũng như con thú vật vô tri, thì dùng mà làm hư mình.",
          "cross_references": []
        },
        {
          "global_id": 30662,
          "verse_code": 65001011,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 11,
          "section_title": "Đạo giả và thầy dối",
          "text": "Khốn nạn thay cho chúng nó, vì đã theo đường của Ca-in, lấy lòng tham lợi mà gieo mình vào sự sai lạc của Ba-la-am; và bị hư mất về sự phản nghịch của Cô-rê.",
          "cross_references": [
            "Sa 4:3-8",
            "Dan 22:1-35",
            "16:1-35"
          ]
        },
        {
          "global_id": 30663,
          "verse_code": 65001012,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 12,
          "section_title": "Đạo giả và thầy dối",
          "text": "Những kẻ đó là dấu vít trong đám tiệc anh em, như người chăn chiên chỉ tưởng nuôi mình cho no nê, không lo sợ gì; như đám mây không nước, theo gió đưa đi đây đi đó, như cây tàn mùa thu, không có trái, hai lần chết, trốc lên bựt rễ;",
          "cross_references": []
        },
        {
          "global_id": 30664,
          "verse_code": 65001013,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 13,
          "section_title": "Đạo giả và thầy dối",
          "text": "như sóng cuồng dưới biển, sôi bọt ô uế của mình; như sao đi lạc, sự tối tăm mù mịt đã dành cho chúng nó đời đời!",
          "cross_references": []
        },
        {
          "global_id": 30665,
          "verse_code": 65001014,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 14,
          "section_title": "Đạo giả và thầy dối",
          "text": "Ấy cũng vì họ mà Hê-nóc, là tổ bảy đời kể từ A-đam, đã nói tiên tri rằng:",
          "cross_references": [
            "Sa 5:18,21-24"
          ]
        },
        {
          "global_id": 30666,
          "verse_code": 65001015,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 15,
          "section_title": "Đạo giả và thầy dối",
          "text": "Nầy, Chúa ngự đến với muôn vàn thánh, đặng phán xét mọi người, đặng trách hết thảy những người không tin kính về mọi việc không tin kính họ đã phạm, cùng mọi lời sỉ hổ mà những kẻ có tội không tin kính đó đã nói nghịch cùng Ngài.",
          "cross_references": []
        },
        {
          "global_id": 30667,
          "verse_code": 65001016,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 16,
          "section_title": "Đạo giả và thầy dối",
          "text": "Ấy đều là những kẻ hay lằm bằm, hay phàn nàn luôn về số phận mình, làm theo sự ham muốn mình, miệng đầy những lời kiêu căng, và vì lợi mà nịnh hót người ta.",
          "cross_references": []
        },
        {
          "global_id": 30668,
          "verse_code": 65001017,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 17,
          "section_title": "Đạo giả và thầy dối",
          "text": "Nhưng anh em, là kẻ rất yêu dấu, hãy nhớ lấy những lời mà các sứ đồ của Đức Chúa Jêsus Christ chúng ta đã nói trước.",
          "cross_references": []
        },
        {
          "global_id": 30669,
          "verse_code": 65001018,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 18,
          "section_title": "Đạo giả và thầy dối",
          "text": "Các sứ đồ đó nói với anh em rằng, trong các thời kỳ sau rốt, sẽ có mấy người hay nhạo báng làm theo lòng ham muốn không tin kính của mình.",
          "cross_references": [
            "2Phi 3:3"
          ]
        },
        {
          "global_id": 30670,
          "verse_code": 65001019,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 19,
          "section_title": "Đạo giả và thầy dối",
          "text": "Ấy chính chúng nó là kẻ gây nên phe đảng, thuộc về tánh xác thịt, không có Đức Thánh Linh.",
          "cross_references": []
        },
        {
          "global_id": 30671,
          "verse_code": 65001020,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 20,
          "section_title": "Khuyên về sự bền đỗ",
          "text": "Hỡi kẻ rất yêu dấu, về phần anh em, hãy tự lập lấy trên nền đức tin rất thánh của mình, và nhân Đức Thánh Linh mà cầu nguyện,",
          "cross_references": []
        },
        {
          "global_id": 30672,
          "verse_code": 65001021,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 21,
          "section_title": "Khuyên về sự bền đỗ",
          "text": "hãy giữ mình trong sự yêu mến Đức Chúa Trời, và trông đợi sự thương xót của Đức Chúa Jêsus Christ chúng ta cho được sự sống đời đời.",
          "cross_references": []
        },
        {
          "global_id": 30673,
          "verse_code": 65001022,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 22,
          "section_title": "Khuyên về sự bền đỗ",
          "text": "Hãy trách phạt những kẻ nầy, là kẻ trù trừ,",
          "cross_references": []
        },
        {
          "global_id": 30674,
          "verse_code": 65001023,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 23,
          "section_title": "Khuyên về sự bền đỗ",
          "text": "hãy cứu vớt những kẻ kia, rút họ ra khỏi lửa; còn đối với kẻ khác, hãy có lòng thương lẫn với sợ, ghét cả đến cái áo bị xác thịt làm ô uế.",
          "cross_references": []
        },
        {
          "global_id": 30675,
          "verse_code": 65001024,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 24,
          "section_title": "Khuyên về sự bền đỗ",
          "text": "Vả, nguyền Đấng có thể gìn giữ anh em khỏi vấp phạm và khiến anh em đứng trước mặt vinh hiển mình cách rất vui mừng, không chỗ trách được,",
          "cross_references": []
        },
        {
          "global_id": 30676,
          "verse_code": 65001025,
          "book_order": 65,
          "book_code": "giu",
          "osis": "Jude",
          "book_name": "Giu-đe",
          "book_name_en": "Jude",
          "testament": "NT",
          "chapter": 1,
          "verse": 25,
          "section_title": "Khuyên về sự bền đỗ",
          "text": "là Đức Chúa Trời có một, là Cứu Chúa chúng ta, bởi Đức Chúa Jêsus Christ là Chúa chúng ta, được sự vinh hiển, tôn trọng, thế lực, quyền năng thuộc về Ngài từ trước vô cùng và hiện nay cho đến đời đời! A-men.",
          "cross_references": []
        }
      ]
    }
  ]
}