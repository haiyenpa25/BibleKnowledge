  "chapters": [
    {
      "chapter": 1,
      "total_verses": 25,
      "verses": [
        {
          "global_id": 29917,
          "verse_code": 57001001,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 1,
          "section_title": "Lời đạt và chào thăm",
          "text": "Phao-lô, kẻ tù của Đức Chúa Jêsus Christ, và Ti-mô-thê, anh em chúng ta, gởi cho Phi-lê-môn, là người rất yêu dấu và cùng làm việc với chúng ta,",
          "cross_references": []
        },
        {
          "global_id": 29918,
          "verse_code": 57001002,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 2,
          "section_title": "Lời đạt và chào thăm",
          "text": "cùng cho Áp-bi là người chị em, A-chíp, là bạn cùng đánh trận, lại cho Hội thánh nhóm họp trong nhà anh:",
          "cross_references": [
            "Co 4:17"
          ]
        },
        {
          "global_id": 29919,
          "verse_code": 57001003,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 3,
          "section_title": "Lời đạt và chào thăm",
          "text": "nguyền xin anh em được ân điển và sự bình an ban cho bởi Đức Chúa Trời, Cha chúng ta, và bởi Đức Chúa Jêsus Christ!",
          "cross_references": [
            "Xem chú thích ở Lu 2:40"
          ]
        },
        {
          "global_id": 29920,
          "verse_code": 57001004,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 4,
          "section_title": "Đức tin và lòng thương yêu của Phi-lê-môn",
          "text": "Tôi cảm tạ Đức Chúa Trời tôi, hằng ghi nhớ anh trong lời cầu nguyện,",
          "cross_references": []
        },
        {
          "global_id": 29921,
          "verse_code": 57001005,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 5,
          "section_title": "Đức tin và lòng thương yêu của Phi-lê-môn",
          "text": "vì nghe nói anh có lòng yêu thương và đức tin trong Đức Chúa Jêsus và cùng các thánh đồ.",
          "cross_references": []
        },
        {
          "global_id": 29922,
          "verse_code": 57001006,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 6,
          "section_title": "Đức tin và lòng thương yêu của Phi-lê-môn",
          "text": "Tôi cầu xin Ngài rằng đức tin đó, là đức tin chung cho chúng ta, được có hiệu nghiệm, khiến người ta biết ấy là vì Đấng Christ mà mọi điều lành được làm trong chúng ta.",
          "cross_references": []
        },
        {
          "global_id": 29923,
          "verse_code": 57001007,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 7,
          "section_title": "Đức tin và lòng thương yêu của Phi-lê-môn",
          "text": "Vả, hỡi anh, tôi đã được vui mừng yên ủi lắm bởi lòng yêu thương của anh, vì nhờ anh mà lòng các thánh đồ được yên ủi.",
          "cross_references": []
        },
        {
          "global_id": 29924,
          "verse_code": 57001008,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 8,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "Vậy nên, dầu trong Đấng Christ, tôi có quyền truyền dạy anh việc nên làm,",
          "cross_references": []
        },
        {
          "global_id": 29925,
          "verse_code": 57001009,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 9,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "song vì lòng yêu thương của anh, nên tôi nài xin thì hơn. Tôi, Phao-lô, đã già rồi, hiện nay lại vì Đức Chúa Jêsus Christ chịu tù nữa,",
          "cross_references": []
        },
        {
          "global_id": 29926,
          "verse_code": 57001010,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 10,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "tôi vì con tôi đã sanh trong vòng xiềng xích, tức là Ô-nê-sim, mà nài xin anh;",
          "cross_references": [
            "Co 4:9"
          ]
        },
        {
          "global_id": 29927,
          "verse_code": 57001011,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 11,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "ngày trước người không ích gì cho anh, nhưng bây giờ sẽ ích lắm, và cũng ích cho tôi nữa: tôi sai người về cùng anh,",
          "cross_references": []
        },
        {
          "global_id": 29928,
          "verse_code": 57001012,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 12,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "người như lòng dạ tôi vậy.",
          "cross_references": []
        },
        {
          "global_id": 29929,
          "verse_code": 57001013,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 13,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "Tôi vốn muốn cầm người ở lại cùng tôi, đặng thế cho anh mà giúp việc tôi trong cơn vì Tin lành chịu xiềng xích.",
          "cross_references": []
        },
        {
          "global_id": 29930,
          "verse_code": 57001014,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 14,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "Nhưng tôi không muốn làm điều gì mà chưa được anh đồng ý, hầu cho điều lành anh sẽ làm chẳng phải bởi ép buộc, bèn là bởi lòng thành.",
          "cross_references": []
        },
        {
          "global_id": 29931,
          "verse_code": 57001015,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 15,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "Vả, có lẽ người đã tạm xa cách anh, cốt để anh nhận lấy người mãi mãi,",
          "cross_references": []
        },
        {
          "global_id": 29932,
          "verse_code": 57001016,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 16,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "không coi như tôi mọi nữa, nhưng coi hơn tôi mọi, coi như anh em yêu dấu, nhứt là yêu dấu cho tôi, huống chi cho anh, cả về phần xác, cả về phần trong Chúa nữa!",
          "cross_references": []
        },
        {
          "global_id": 29933,
          "verse_code": 57001017,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 17,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "Vậy nếu anh coi tôi là bạn hữu anh, thì hãy nhận lấy người như chính mình tôi vậy.",
          "cross_references": []
        },
        {
          "global_id": 29934,
          "verse_code": 57001018,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 18,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "Nhược bằng người có làm hại anh hoặc mắc nợ anh điều chi, thì hãy cứ kể cho tôi.",
          "cross_references": []
        },
        {
          "global_id": 29935,
          "verse_code": 57001019,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 19,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "Tôi, Phao-lô, chính tay tôi viết điều nầy: sẽ trả cho anh, --- còn anh mắc nợ tôi về chính mình anh thì không nhắc đến. ---",
          "cross_references": []
        },
        {
          "global_id": 29936,
          "verse_code": 57001020,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 20,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "Phải, hỡi anh, ước chi tôi được nhận sự vui vẻ nầy bởi anh trong Chúa; anh hãy làm cho tôi được thỏa lòng trong Đấng Christ.",
          "cross_references": []
        },
        {
          "global_id": 29937,
          "verse_code": 57001021,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 21,
          "section_title": "Phao-lô vì Ô-nê-sim cầu xin",
          "text": "Tôi viết cho anh, đã tin chắc anh hay vâng lời, biết anh sẽ làm quá sự tôi nói đây.",
          "cross_references": []
        },
        {
          "global_id": 29938,
          "verse_code": 57001022,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 22,
          "section_title": "Phao-lô sẽ trở về",
          "text": "Nhân thể hãy liệu sắm nhà trọ cho tôi, vì tôi mong rằng nhờ anh em cầu nguyện, sẽ được trở về cùng anh em.",
          "cross_references": []
        },
        {
          "global_id": 29939,
          "verse_code": 57001023,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 23,
          "section_title": "Phao-lô sẽ trở về",
          "text": "Ê-pháp-ra, là bạn đồng tù trong Đức Chúa Jêsus Christ với tôi, có lời thăm anh,",
          "cross_references": [
            "Co 1:7",
            "4:12"
          ]
        },
        {
          "global_id": 29940,
          "verse_code": 57001024,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 24,
          "section_title": "Phao-lô sẽ trở về",
          "text": "Mác, A-ri-tạc, Đê-ma và Lu-ca, cùng là bạn cùng làm việc với tôi cũng vậy.",
          "cross_references": [
            "Cong 12:12,25",
            "13:13",
            "15:37-39",
            "19:29",
            "27:2",
            "Co 4:10,14",
            "2Ti 4:10,11"
          ]
        },
        {
          "global_id": 29941,
          "verse_code": 57001025,
          "book_order": 57,
          "book_code": "phil",
          "osis": "Phlm",
          "book_name": "Phi-lê-môn",
          "book_name_en": "Philemon",
          "testament": "NT",
          "chapter": 1,
          "verse": 25,
          "section_title": "Phao-lô sẽ trở về",
          "text": "Nguyền xin ân điển của Đức Chúa Jêsus Christ ở với tâm thần anh em!",
          "cross_references": []
        }
      ]
    }
  ]
}