          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 10,
          "section_title": "Sự phán xét các nước",
          "text": "Hãy lấy lưỡi cày rèn gươm, lấy liềm rèn giáo. Kẻ yếu khá nói rằng: Ta là mạnh!",
          "cross_references": [
            "Es 2:4",
            "Mi 4:3"
          ]
        },
        {
          "global_id": 22347,
          "verse_code": 29003011,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 11,
          "section_title": "Sự phán xét các nước",
          "text": "Các ngươi hết thảy, là những nước xung quanh, hãy vội vàng đến, và hãy nhóm lại. Hỡi Đức Giê-hô-va, xin khiến những người mạnh mẽ của Ngài xuống đó!",
          "cross_references": []
        },
        {
          "global_id": 22348,
          "verse_code": 29003012,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 12,
          "section_title": "Sự phán xét các nước",
          "text": "Các nước khá dấy lên, khá lên trong trũng Giô-sa-phát, vì ở đó là nơi ta sẽ ngồi đặng phán xét hết thảy các dân tộc xung quanh.",
          "cross_references": []
        },
        {
          "global_id": 22349,
          "verse_code": 29003013,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 13,
          "section_title": "Sự phán xét các nước",
          "text": "Hãy tra lưỡi hái, vì mùa gặt đã chín. Hãy đến, hãy đạp, vì bàn ép đã đầy; các thùng đã tràn, vì tội ác chúng nó là lớn.",
          "cross_references": [
            "Kh 14:14-16,19-20",
            "19:15"
          ]
        },
        {
          "global_id": 22350,
          "verse_code": 29003014,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 14,
          "section_title": "Sự phán xét các nước",
          "text": "Đoàn đông dường nào, đoàn đông dường nào tại trong trũng đoán định! Vì trong trũng đoán định, ngày Đức Giê-hô-va đã gần.",
          "cross_references": []
        },
        {
          "global_id": 22351,
          "verse_code": 29003015,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 15,
          "section_title": "Sự phán xét các nước",
          "text": "Mặt trời và mặt trăng tối tăm, các ngôi sao thâu sự sáng lại.",
          "cross_references": []
        },
        {
          "global_id": 22352,
          "verse_code": 29003016,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 16,
          "section_title": "Sự phán xét các nước",
          "text": "Đức Giê-hô-va gầm thét từ Si-ôn; Ngài làm cho vang tiếng mình ra từ Giê-ru-sa-lem; các từng trời và đất đều rúng động. Nhưng Đức Giê-hô-va là nơi ẩn náu cho dân mình, là đồn lũy cho con cái Y-sơ-ra-ên.",
          "cross_references": [
            "Am 1:2"
          ]
        },
        {
          "global_id": 22353,
          "verse_code": 29003017,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 17,
          "section_title": "Sự phán xét các nước",
          "text": "Như vậy các ngươi sẽ biết ta là Giê-hô-va Đức Chúa Trời các ngươi, ở tại Si-ôn, là núi thánh ta. Bấy giờ Giê-ru-sa-lem sẽ là thánh, và những người ngoại sẽ không đi qua trong đó nữa.",
          "cross_references": []
        },
        {
          "global_id": 22354,
          "verse_code": 29003018,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 18,
          "section_title": "Sự ban phước được hứa cho dân Đức Chúa Trời",
          "text": "Trong ngày đó, các núi nhỏ rượu ngọt ra; sữa chảy ra từ các đồi, hết thảy các khe Giu-đa sẽ có nước chảy. Một cái suối sẽ ra từ nhà Đức Giê-hô-va và tưới trũng Si-tim.",
          "cross_references": []
        },
        {
          "global_id": 22355,
          "verse_code": 29003019,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 19,
          "section_title": "Sự ban phước được hứa cho dân Đức Chúa Trời",
          "text": "Ê-díp-tô sẽ trở nên hoang vu, Ê-đôm thành ra đồng vắng hoang vu, vì cớ chúng nó lấy sự bạo ngược đãi con cái Giu-đa, và làm đổ máu vô tội ra trong đất mình.",
          "cross_references": []
        },
        {
          "global_id": 22356,
          "verse_code": 29003020,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 3,
          "verse": 20,
          "section_title": "Sự ban phước được hứa cho dân Đức Chúa Trời",
          "text": "Nhưng Giu-đa sẽ còn đời đời, Giê-ru-sa-lem sẽ còn đời nầy qua đời khác.",
          "cross_references": []
        },
        {
