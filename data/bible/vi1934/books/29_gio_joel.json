{
  "order": 29,
  "code": "gio",
  "osis": "Joel",
  "name_vi": "Giô-ên",
  "name_en": "Joel",
  "testament": "OT",
  "chapter_count": 3,
  "total_verses": 73,
  "chapters": [
    {
      "chapter": 1,
      "total_verses": 20,
      "verses": [
        {
          "global_id": 22285,
          "verse_code": 29001001,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 1,
          "section_title": "Sự cào cào tràn tới",
          "text": "Nầy là lời Đức Giê-hô-va phán cùng Giô-ên, con trai của Phê-thu-ên:",
          "cross_references": []
        },
        {
          "global_id": 22286,
          "verse_code": 29001002,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 2,
          "section_title": "Sự cào cào tràn tới",
          "text": "Hỡi kẻ già cả, hãy nghe điều nầy! Các ngươi hết thảy là dân cư trong đất, hãy lắng tai! Há có sự gì như vậy đã xảy đến trong ngày các ngươi, hay là trong ngày tổ phụ các ngươi sao?",
          "cross_references": []
        },
        {
          "global_id": 22287,
          "verse_code": 29001003,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 3,
          "section_title": "Sự cào cào tràn tới",
          "text": "Hãy kể chuyện nầy lại cho con cái các ngươi; con cái các ngươi kể cho con cái chúng nó, con cái chúng nó kể cho dòng dõi nối theo.",
          "cross_references": []
        },
        {
          "global_id": 22288,
          "verse_code": 29001004,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 4,
          "section_title": "Sự cào cào tràn tới",
          "text": "Cái gì sâu keo còn để lại, cào cào ăn; cái gì cào cào còn để lại, sâu lột vỏ ăn; cái gì sâu lột vỏ còn để lại, châu chấu ăn.",
          "cross_references": []
        },
        {
          "global_id": 22289,
          "verse_code": 29001005,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 5,
          "section_title": "Sự cào cào tràn tới",
          "text": "Hỡi kẻ say sưa, hãy thức dậy và khóc lóc! Hỡi các ngươi hết thảy là kẻ hay uống rượu, hãy than vãn vì cớ rượu ngọt đã bị cất khỏi miệng các ngươi!",
          "cross_references": []
        },
        {
          "global_id": 22290,
          "verse_code": 29001006,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 6,
          "section_title": "Sự cào cào tràn tới",
          "text": "Vì một dân mạnh và vô số, đã lên nghịch cùng đất ta; răng nó là răng của sư tử, nó có răng hàm của sư tử cái.",
          "cross_references": [
            "Kh 9:8"
          ]
        },
        {
          "global_id": 22291,
          "verse_code": 29001007,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 7,
          "section_title": "Sự cào cào tràn tới",
          "text": "Nó đã hủy phá cây nho ta và lột vỏ cây vả ta. Nó đã lột tiệt cây ấy và bỏ đi; nhánh nó đã trở nên trắng.",
          "cross_references": []
        },
        {
          "global_id": 22292,
          "verse_code": 29001008,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 8,
          "section_title": "Sự cào cào tràn tới",
          "text": "Ngươi khá than khóc như một người nữ đồng trinh mặc bao gai đặng khóc chồng mình thuở còn trẻ tuổi!",
          "cross_references": []
        },
        {
          "global_id": 22293,
          "verse_code": 29001009,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 9,
          "section_title": "Sự cào cào tràn tới",
          "text": "Của lễ chay và lễ quán đã cất khỏi nhà Đức Giê-hô-va; các thầy tế lễ hầu việc Đức Giê-hô-va đương ở trong sự tang chế.",
          "cross_references": []
        },
        {
          "global_id": 22294,
          "verse_code": 29001010,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 10,
          "section_title": "Sự cào cào tràn tới",
          "text": "Đồng ruộng bị phá hoang, và đất đương sầu thảm; vì lúa mì bị hủy hại, rượu mới đã cạn, dầu đã hao tổn.",
          "cross_references": []
        },
        {
          "global_id": 22295,
          "verse_code": 29001011,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 11,
          "section_title": "Sự cào cào tràn tới",
          "text": "Hỡi kẻ cày ruộng, hãy hổ thẹn; hỡi kẻ làm vườn nho, hãy than khóc, vì cớ lúa mì và mạch nha, vì mùa ngoài đồng đã mất.",
          "cross_references": []
        },
        {
          "global_id": 22296,
          "verse_code": 29001012,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 12,
          "section_title": "Sự cào cào tràn tới",
          "text": "Cây nho khô héo, cây vả hao mòn; cây lựu cũng như cây chà là, cây tần, mọi cây cối ngoài đồng đều khô héo; sự vui vẻ đã khô héo đi khỏi con trai loài người!",
          "cross_references": []
        },
        {
          "global_id": 22297,
          "verse_code": 29001013,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 13,
          "section_title": "Khuyên về sự ăn năn",
          "text": "Hỡi các thầy tế lễ, hãy nịt lưng và than khóc. Hỡi các ngươi là kẻ làm việc ở bàn thờ, hãy thở than. Hỡi kẻ chức dịch của Đức Chúa Trời ta, hãy đến mặc áo bao gai mà nằm cả đêm! Vì của lễ chay và lễ quán không được vào trong nhà Đức Chúa Trời các ngươi!",
          "cross_references": []
        },
        {
          "global_id": 22298,
          "verse_code": 29001014,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 14,
          "section_title": "Khuyên về sự ăn năn",
          "text": "Khá định sự kiêng ăn, gọi một hội đồng trọng thể, nhóm các trưởng lão và hết thảy dân cư trong đất lại nơi nhà Giê-hô-va Đức Chúa Trời các ngươi; và hãy kêu cùng Đức Giê-hô-va!",
          "cross_references": []
        },
        {
          "global_id": 22299,
          "verse_code": 29001015,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 15,
          "section_title": "Khuyên về sự ăn năn",
          "text": "Ôi ngày ấy! Vì ngày Đức Giê-hô-va đã gần! Nó đến như một tai vạ thả ra bởi Đấng Toàn năng.",
          "cross_references": [
            "Es 13:6"
          ]
        },
        {
          "global_id": 22300,
          "verse_code": 29001016,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 16,
          "section_title": "Khuyên về sự ăn năn",
          "text": "Lương thực há chẳng phải đã dứt khỏi trước mặt chúng ta, và sự vui mừng hớn hở há chẳng phải đã dứt khỏi nhà Đức Chúa Trời chúng ta hay sao?",
          "cross_references": []
        },
        {
          "global_id": 22301,
          "verse_code": 29001017,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 17,
          "section_title": "Khuyên về sự ăn năn",
          "text": "Hột giống đã teo đi dưới những cục đất nó; kho đụn đã hủy phá, huân lẫm đổ nát, vì lúa mì khô héo.",
          "cross_references": []
        },
        {
          "global_id": 22302,
          "verse_code": 29001018,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 18,
          "section_title": "Khuyên về sự ăn năn",
          "text": "Kìa, súc vật rên siết! Kìa, bầy bò bối rối! Ấy là tại chúng nó không có đồng cỏ nữa! Những bầy chiên cũng khốn khổ.",
          "cross_references": []
        },
        {
          "global_id": 22303,
          "verse_code": 29001019,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 19,
          "section_title": "Khuyên về sự ăn năn",
          "text": "Hỡi Đức Giê-hô-va, tôi kêu cầu Ngài; vì lửa đã nuốt những đám cỏ nơi đồng vắng, ngọn lửa đã thiêu hết thảy cây cối ngoài đồng!",
          "cross_references": []
        },
        {
          "global_id": 22304,
          "verse_code": 29001020,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 1,
          "verse": 20,
          "section_title": "Khuyên về sự ăn năn",
          "text": "Thật, những thú đồng cũng thở dốc cho Ngài, vì các dòng nước đã khô, lửa đã nuốt những đám cỏ nơi đồng vắng.",
          "cross_references": []
        }
      ]
    },
    {
      "chapter": 2,
      "total_verses": 32,
      "verses": [
        {
          "global_id": 22305,
          "verse_code": 29002001,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 1,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "Hãy thổi kèn trong Si-ôn; hãy thổi vang ra trên núi thánh ta! Hết thảy dân cư trong đất khá đều run rẩy! Vì ngày của Đức Giê-hô-va đến, ngày ấy đã gần:",
          "cross_references": []
        },
        {
          "global_id": 22306,
          "verse_code": 29002002,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 2,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "tức là ngày mờ mịt và tối tăm, ngày của mây và sương mù. Có một dân lớn và mạnh đến như ánh sáng sớm mai giãi ra trên núi, đến nỗi từ trước chưa hề có, mà về sau nầy, về muôn đời sau nầy cũng sẽ không có như vậy nữa.",
          "cross_references": []
        },
        {
          "global_id": 22307,
          "verse_code": 29002003,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 3,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "Trước mặt nó, có lửa thiêu nuốt, sau lưng nó, có ngọn lửa cháy tiêu. Lúc trước nó, đất nầy như vườn Ê-đen; khi sau nó, ấy là một đồng vắng hoang vu, và không có chi trốn khỏi nó hết.",
          "cross_references": []
        },
        {
          "global_id": 22308,
          "verse_code": 29002004,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 4,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "Hình trạng chúng nó như hình trạng ngựa, và chúng nó chạy tới như người cỡi ngựa.",
          "cross_references": [
            "Kh 9:7-9"
          ]
        },
        {
          "global_id": 22309,
          "verse_code": 29002005,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 5,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "Khi chúng nó nhảy lên trên chót núi, thì nghe như tiếng xe cộ, hay là như tiếng ngọn lửa cháy rơm: ấy là như một dân mạnh sắp hàng nơi chiến trận.",
          "cross_references": []
        },
        {
          "global_id": 22310,
          "verse_code": 29002006,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 6,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "Khi thấy chúng nó, các dân đều rầu rĩ, hết thảy đều sợ tái mặt.",
          "cross_references": []
        },
        {
          "global_id": 22311,
          "verse_code": 29002007,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 7,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "Chúng nó chạy như những người bạo mạnh; trèo các vách thành như những lính chiến; mỗi người bước đi trước mặt mình, chẳng hề sai hàng ngũ mình.",
          "cross_references": []
        },
        {
          "global_id": 22312,
          "verse_code": 29002008,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 8,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "Chúng nó chẳng hề đụng chạm nhau, ai đi đường nấy; xông qua những khí giới mà chẳng bỏ đường mình.",
          "cross_references": []
        },
        {
          "global_id": 22313,
          "verse_code": 29002009,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 9,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "Chúng nó nhảy trên thành phố, chạy trên tường, trèo lên các nhà, vào bởi các cửa sổ như là kẻ trộm.",
          "cross_references": []
        },
        {
          "global_id": 22314,
          "verse_code": 29002010,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 10,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "Đất run rẩy, trước mặt chúng nó, các từng trời rung rinh, mặt trời mặt trăng đều tối tăm, các ngôi sao thâu sự sáng lại.",
          "cross_references": [
            "Kh 8:12"
          ]
        },
        {
          "global_id": 22315,
          "verse_code": 29002011,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 11,
          "section_title": "Ngày Đức Giê-hô-va đến gần",
          "text": "Đức Giê-hô-va làm cho vang tiếng ra trước mặt cơ binh Ngài; vì trại quân Ngài rất lớn; và những kẻ làm theo mạng lịnh Ngài rất mạnh. Thật, ngày của Đức Giê-hô-va là lớn và đáng khiếp; ai có thể đương lại?",
          "cross_references": [
            "Kh 6:17"
          ]
        },
        {
          "global_id": 22316,
          "verse_code": 29002012,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 12,
          "section_title": "Gọi đến sự ăn năn",
          "text": "Đức Giê-hô-va phán: Bây giờ cũng hãy hết lòng trở về cùng ta, kiêng ăn, khóc lóc và buồn rầu.",
          "cross_references": []
        },
        {
          "global_id": 22317,
          "verse_code": 29002013,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 13,
          "section_title": "Gọi đến sự ăn năn",
          "text": "Hãy xé lòng các ngươi, và đừng xé áo các ngươi. Khá trở lại cùng Giê-hô-va Đức Chúa Trời các ngươi; vì Ngài là nhân từ và hay thương xót, chậm giận và giàu ơn, đổi ý về sự tai vạ.",
          "cross_references": []
        },
        {
          "global_id": 22318,
          "verse_code": 29002014,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 14,
          "section_title": "Gọi đến sự ăn năn",
          "text": "Ai biết được Ngài sẽ chẳng xây lòng đổi ý, chẳng để lại phước lành sau mình, tức là của lễ chay, lễ quán cho Giê-hô-va Đức Chúa Trời các ngươi, hay sao?",
          "cross_references": []
        },
        {
          "global_id": 22319,
          "verse_code": 29002015,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 15,
          "section_title": "Gọi đến sự ăn năn",
          "text": "Hãy thổi kèn trong Si-ôn; hãy định sự kiêng ăn, gọi một hội đồng trọng thể!",
          "cross_references": []
        },
        {
          "global_id": 22320,
          "verse_code": 29002016,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 16,
          "section_title": "Gọi đến sự ăn năn",
          "text": "Hãy nhóm dân sự, biệt riêng hội chúng nên thánh; hãy mời các trưởng lão đến đó! Hãy họp lại các con trẻ, và những đứa đương bú vú! Người chồng mới khá ra khỏi buồng mình, và người vợ mới khá ra khỏi chốn động phòng!",
          "cross_references": []
        },
        {
          "global_id": 22321,
          "verse_code": 29002017,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 17,
          "section_title": "Gọi đến sự ăn năn",
          "text": "Các thầy tế lễ, là những kẻ hầu việc Đức Giê-hô-va, khá khóc lóc giữa hiên cửa và bàn thờ, và nói rằng: Hỡi Đức Giê-hô-va, xin hãy tiếc dân Ngài, và chớ để cơ nghiệp Ngài bị sỉ nhục, và bị các nước cai trị! Làm sao để người ta nói giữa các dân tộc rằng: Nào Đức Chúa Trời chúng nó ở đâu?",
          "cross_references": []
        },
        {
          "global_id": 22322,
          "verse_code": 29002018,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 18,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Đức Giê-hô-va đã vì đất mình động lòng ghen; Ngài đã động lòng thương xót dân mình.",
          "cross_references": []
        },
        {
          "global_id": 22323,
          "verse_code": 29002019,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 19,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Đức Giê-hô-va đã trả lời, và đã phán cùng dân mình rằng: Nầy, ta sẽ ban cho các ngươi lúa mì, rượu mới, và dầu, các ngươi sẽ no nê về các thứ đó. Ta sẽ chẳng làm các ngươi nên cớ sỉ nhục giữa các dân nữa.",
          "cross_references": []
        },
        {
          "global_id": 22324,
          "verse_code": 29002020,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 20,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Ta sẽ khiến đạo binh đến từ phương bắc lánh xa các ngươi, và đuổi nó vào đất khô khan và hoang vu, quân tiên phong nó vào biển đông. Quân hậu tập nó vào biển tây. Mùi hôi nó bay lên, mùi tanh nó dậy lên, vì nó đã làm những việc lớn.",
          "cross_references": []
        },
        {
          "global_id": 22325,
          "verse_code": 29002021,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 21,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Hỡi đất, chớ sợ chi; hãy nức lòng vui vẻ và mừng rỡ; vì Đức Giê-hô-va đã làm những việc lớn.",
          "cross_references": []
        },
        {
          "global_id": 22326,
          "verse_code": 29002022,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 22,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Hỡi các loài thú đồng, đừng sợ; vì những đám cỏ nơi đồng vắng nứt đọt, cây ra trái, cây vả và cây nho đều ra sức nó.",
          "cross_references": []
        },
        {
          "global_id": 22327,
          "verse_code": 29002023,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 23,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Hỡi con cái Si-ôn, các ngươi hãy nức lòng vui vẻ và mừng rỡ trong Giê-hô-va Đức Chúa Trời các ngươi! Vì Ngài ban mưa phải thời cho các ngươi về mùa đầu, và xuống mưa dồi dào về mùa đầu và mùa cuối cho các ngươi nơi tháng đầu tiên.",
          "cross_references": []
        },
        {
          "global_id": 22328,
          "verse_code": 29002024,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 24,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Những sân sẽ đầy lúa mì, những thùng tràn rượu mới và dầu.",
          "cross_references": []
        },
        {
          "global_id": 22329,
          "verse_code": 29002025,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 25,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Ta sẽ đền bù cho các ngươi về mấy năm đã bị cắn phá bởi cào cào, sâu lột vỏ, sâu keo, và châu chấu, là đạo binh lớn mà ta đã sai đến giữa các ngươi.",
          "cross_references": []
        },
        {
          "global_id": 22330,
          "verse_code": 29002026,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 26,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Các ngươi sẽ đủ ăn và được no nê. Các ngươi sẽ ngợi khen danh Giê-hô-va Đức Chúa Trời mình, là Đấng đã xử với các ngươi cách lạ lùng. Rồi dân ta sẽ không hề bị xấu hổ nữa.",
          "cross_references": []
        },
        {
          "global_id": 22331,
          "verse_code": 29002027,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 27,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Các ngươi sẽ biết rằng ta ở giữa Y-sơ-ra-ên, biết rằng ta là Giê-hô-va Đức Chúa Trời các ngươi, và chẳng có ai khác; dân ta sẽ không hề bị xấu hổ nữa.",
          "cross_references": []
        },
        {
          "global_id": 22332,
          "verse_code": 29002028,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 28,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Sau đó, ta sẽ đổ Thần ta trên cả loài xác thịt; con trai và con gái các ngươi sẽ nói tiên tri; những người già cả các ngươi sẽ thấy chiêm bao, những kẻ trai trẻ các ngươi sẽ xem sự hiện thấy.",
          "cross_references": [
            "Cong 2:17-21"
          ]
        },
        {
          "global_id": 22333,
          "verse_code": 29002029,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 29,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Trong những ngày đó, dầu những đầy tớ trai và đầy tớ gái, ta cũng đổ Thần ta lên.",
          "cross_references": []
        },
        {
          "global_id": 22334,
          "verse_code": 29002030,
          "book_order": 29,
          "book_code": "gio",
          "osis": "Joel",
          "book_name": "Giô-ên",
          "book_name_en": "Joel",
          "testament": "OT",
          "chapter": 2,
          "verse": 30,
          "section_title": "Sự trở lại của ơn Đức Chúa Trời",
          "text": "Ta sẽ tỏ những sự lạ ra trong các từng trời và trên đất: tức là máu, lửa, và những trụ khói.",
          "cross_references": []
        },
        {
