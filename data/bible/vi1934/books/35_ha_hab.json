{
  "order": 35,
  "code": "ha",
  "osis": "Hab",
  "name_vi": "Ha-ba-cúc",
  "name_en": "Habakkuk",
  "testament": "OT",
  "chapter_count": 3,
  "total_verses": 56,
  "chapters": [
    {
      "chapter": 1,
      "total_verses": 17,
      "verses": [
        {
          "global_id": 22724,
          "verse_code": 35001001,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 1,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Nầy là gánh nặng mà đấng tiên tri Ha-ba-cúc đã xem thấy.",
          "cross_references": []
        },
        {
          "global_id": 22725,
          "verse_code": 35001002,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 2,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Hỡi Đức Giê-hô-va! Tôi kêu van mà Ngài không nghe tôi cho đến chừng nào? Tôi vì cớ sự bạo ngược kêu van cùng Ngài, mà Ngài chẳng khứng giải cứu tôi!",
          "cross_references": []
        },
        {
          "global_id": 22726,
          "verse_code": 35001003,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 3,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Nhân sao Chúa khiến tôi thấy sự gian ác, và Ngài nhìn xem sự ngang trái? Sự tàn hại bạo ngược ở trước mặt tôi; sự tranh đấu cãi lẫy dấy lên.",
          "cross_references": []
        },
        {
          "global_id": 22727,
          "verse_code": 35001004,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 4,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Vậy nên luật pháp không quyền, sự chánh trực không hề tỏ ra. Kẻ hung ác vây chung quanh người công bình, vì cớ đó sự xét đoán ra trái ngược.",
          "cross_references": []
        },
        {
          "global_id": 22728,
          "verse_code": 35001005,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 5,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Hãy nhìn trong các nước và xem, hãy lấy làm lạ và sững sờ! Vì ta đang làm ra trong ngày các ngươi một việc, mà dầu có ai thuật lại cho các ngươi, các ngươi cũng không tin.",
          "cross_references": [
            "Cong 13:41"
          ]
        },
        {
          "global_id": 22729,
          "verse_code": 35001006,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 6,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Nầy, ta khiến người Canh-đê dấy lên, nó là một dân dữ tợn lung lăng, hay đi khắp đất đặng chiếm lấy những chỗ ở không thuộc về mình.",
          "cross_references": [
            "2Vua 24:2"
          ]
        },
        {
          "global_id": 22730,
          "verse_code": 35001007,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 7,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Nó thật là đáng sợ và đáng ghê, oai nghi và sự phán xét của nó đều là từ nó mà đến.",
          "cross_references": []
        },
        {
          "global_id": 22731,
          "verse_code": 35001008,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 8,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Những ngựa nó nhặm lẹ hơn con beo, và hung hơn muông sói ban đêm. Những lính kỵ nó tràn khắp đây đó, những lính kỵ nó đến từ phương xa; chúng nó bay như chim ưng lẹ, nôn nả kiếm ăn.",
          "cross_references": []
        },
        {
          "global_id": 22732,
          "verse_code": 35001009,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 9,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Cả dân ấy đến đặng làm sự bạo ngược; chúng nó mạnh dạn đi thẳng tới, và dồn phu tù lại như cát.",
          "cross_references": []
        },
        {
          "global_id": 22733,
          "verse_code": 35001010,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 10,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Nó nhạo cười các vua, chế báng các quan trưởng, và chê cười mỗi đồn lũy: Nó đắp lũy, rồi chiếm lấy.",
          "cross_references": []
        },
        {
          "global_id": 22734,
          "verse_code": 35001011,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 11,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Bấy giờ nó sẽ sấn tới như gió thổi qua; vì nó lấy sức mạnh mình làm thần mình, nên phạm tội trọng.",
          "cross_references": []
        },
        {
          "global_id": 22735,
          "verse_code": 35001012,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 12,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Hỡi Giê-hô-va, Đức Chúa Trời tôi, Đấng Thánh của tôi! Ngài há chẳng phải là từ đời đời vô cùng sao? Vậy chúng tôi sẽ không chết! Hỡi Đức Giê-hô-va, Ngài đã lập dân nầy đặng làm sự xét đoán của Ngài. Hỡi vầng Đá! Ngài đã đặt nó đặng làm sự sửa phạt!",
          "cross_references": []
        },
        {
          "global_id": 22736,
          "verse_code": 35001013,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 13,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Mắt Chúa thánh sạch chẳng nhìn sự dữ, chẳng có thể nhìn được sự trái ngược. Sao Ngài nhìn xem kẻ làm sự dối trá, khi kẻ dữ nuốt người công bình hơn nó, sao Ngài nín lặng đi?",
          "cross_references": []
        },
        {
          "global_id": 22737,
          "verse_code": 35001014,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 14,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Sao Ngài khiến loài người như cá biển và như loài côn trùng vô chủ?",
          "cross_references": []
        },
        {
          "global_id": 22738,
          "verse_code": 35001015,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 15,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Nó đã dùng lưỡi câu móc lấy cả, thâu góp trong chài mình, và nhóm lại trong lưới mình, vậy nên nó vui mừng và lấy làm thích.",
          "cross_references": []
        },
        {
          "global_id": 22739,
          "verse_code": 35001016,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 16,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Vì cớ đó, nó dâng tế cho lưới, đốt hương cho chài, bởi chưng nó nhờ đó mà được phần béo tốt và của ăn dư dật.",
          "cross_references": []
        },
        {
          "global_id": 22740,
          "verse_code": 35001017,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 1,
          "verse": 17,
          "section_title": "Người Canh-đê sửa phạt Giu-đa",
          "text": "Có lẽ nào nó cứ đổ lưới mình ra đặng làm sự giết lát các dân không hề thôi sao?",
          "cross_references": []
        }
      ]
    },
    {
      "chapter": 2,
      "total_verses": 20,
      "verses": [
        {
          "global_id": 22741,
          "verse_code": 35002001,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 1,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Ta sẽ đứng nơi vọng canh, chôn chân nơi đồn lũy, rình xem Ngài bảo ta điều gì, và ta trả lời thế nào về sự đối nại của ta.",
          "cross_references": []
        },
        {
          "global_id": 22742,
          "verse_code": 35002002,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 2,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Đức Giê-hô-va đáp lại cùng ta mà rằng: Ngươi khá chép lấy sự hiện thấy, và rõ rệt nó ra trên bảng, hầu cho người đương chạy đọc được.",
          "cross_references": []
        },
        {
          "global_id": 22743,
          "verse_code": 35002003,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 3,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Vì sự hiện thấy còn phải ứng nghiệm trong kỳ nhứt định, sau cùng nó sẽ kíp đến, không phỉnh dối đâu; nếu nó chậm trễ, ngươi hãy đợi; bởi nó chắc sẽ đến, không chậm trễ.",
          "cross_references": [
            "He 10:37"
          ]
        },
        {
          "global_id": 22744,
          "verse_code": 35002004,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 4,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Nầy, lòng người kiêu ngạo, không có sự ngay thẳng trong nó; song người công bình thì sống bởi đức tin mình.",
          "cross_references": [
            "Ro 1:17",
            "Ga 3:11",
            "He 10:38"
          ]
        },
        {
          "global_id": 22745,
          "verse_code": 35002005,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 5,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Nó ghiền rượu, làm sự dối trá, kiêu ngạo và chẳng ở yên chỗ mình, mở rộng lòng ham mê nó như Âm phủ, như sự chết chẳng được no chán; nó thâu góp mọi nước và hội hiệp mọi dân cho mình.",
          "cross_references": []
        },
        {
          "global_id": 22746,
          "verse_code": 35002006,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 6,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Chớ thì những kẻ đó há chẳng lấy thí dụ nhạo cười nó, lấy lời kín biếm nhẻ nó mà rằng: Khốn thay cho kẻ nhóm góp của chẳng thuộc về mình! Nó gánh vác của cầm rất nặng cho đến chừng nào?",
          "cross_references": []
        },
        {
          "global_id": 22747,
          "verse_code": 35002007,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 7,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Há chẳng sẽ có kẻ vụt dấy lên đặng cắn ngươi sao? Kẻ đuổi bắt ngươi há chẳng tỉnh thức sao? Ngươi sẽ bị nó cướp bóc.",
          "cross_references": []
        },
        {
          "global_id": 22748,
          "verse_code": 35002008,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 8,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Vì ngươi đã cướp nhiều nước, thì cả phần sót lại của các dân sẽ cướp ngươi, vì cớ huyết người ta, vì sự bạo ngược làm ra cho đất, cho thành, và cho hết thảy dân cư nó.",
          "cross_references": []
        },
        {
          "global_id": 22749,
          "verse_code": 35002009,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 9,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Khốn thay cho kẻ tìm lợi bất nghĩa cho nhà mình, để lót ổ mình trong nơi cao, để được cứu khỏi tay hung ác.",
          "cross_references": []
        },
        {
          "global_id": 22750,
          "verse_code": 35002010,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 10,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Ngươi đã dùng mưu xấu hổ cho nhà mình mà diệt nhiều dân tộc, ngươi đã phạm tội nghịch cùng linh hồn ngươi.",
          "cross_references": []
        },
        {
          "global_id": 22751,
          "verse_code": 35002011,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 11,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Vì đá trong vách sẽ kêu lên, rường trên mái sẽ đáp lại.",
          "cross_references": []
        },
        {
          "global_id": 22752,
          "verse_code": 35002012,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 12,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Khốn thay cho kẻ lấy huyết dựng ấp, và lấy sự gian ác xây thành!",
          "cross_references": []
        },
        {
          "global_id": 22753,
          "verse_code": 35002013,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 13,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Phải, ấy há chẳng phải bởi Đức Giê-hô-va vạn quân mà các dân làm việc cho lửa, và các nước nhọc nhằn cho sự hư không hay sao?",
          "cross_references": []
        },
        {
          "global_id": 22754,
          "verse_code": 35002014,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 14,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Vì sự nhận biết vinh quang Đức Giê-hô-va sẽ đầy dẫy khắp đất như nước đầy tràn biển.",
          "cross_references": [
            "Es 11:9"
          ]
        },
        {
          "global_id": 22755,
          "verse_code": 35002015,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
