          "testament": "OT",
          "chapter": 2,
          "verse": 15,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Khốn thay cho kẻ pha đồ độc cho người lân cận mình uống, làm cho nó say, đặng xem sự lõa lồ nó!",
          "cross_references": []
        },
        {
          "global_id": 22756,
          "verse_code": 35002016,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 16,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Ngươi đầy sự sỉ nhục mà chẳng đầy sự vinh hiển. Ngươi cũng hãy uống đi, và làm như người chưa chịu phép cắt bì. Chén của Đức Giê-hô-va cầm trong tay hữu sẽ đến phiên trao cho ngươi, và sự nhuốc nhơ sẽ đổ ra trên sự vinh hiển ngươi.",
          "cross_references": []
        },
        {
          "global_id": 22757,
          "verse_code": 35002017,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 17,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Vì sự bạo ngược đã làm ra cho Li-ban sẽ che phủ ngươi, và sự tàn hại các loài thú làm cho nó kinh sợ, lại vì cớ huyết người ta, vì sự bạo ngược làm ra cho đất, cho thành, và cho hết thảy dân cư nó.",
          "cross_references": []
        },
        {
          "global_id": 22758,
          "verse_code": 35002018,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 18,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Tượng chạm mà thợ đã chạm ra, có ích gì cho nó chăng? Tượng đúc, là thầy giả dối, thì có ích gì, mà người thợ làm thần tượng câm ấy lại tin cậy nơi việc mình làm ra?",
          "cross_references": []
        },
        {
          "global_id": 22759,
          "verse_code": 35002019,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 19,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Khốn thay cho kẻ nói với gỗ rằng: Hãy tỉnh thức! Và với đá câm rằng: Hãy chỗi dậy! Nó có dạy dỗ được chăng? Nầy, nó là bọc vàng và bạc, song chẳng có một chút hơi thở nào ở giữa nó.",
          "cross_references": []
        },
        {
          "global_id": 22760,
          "verse_code": 35002020,
          "book_order": 35,
          "book_code": "ha",
          "osis": "Hab",
          "book_name": "Ha-ba-cúc",
          "book_name_en": "Habakkuk",
          "testament": "OT",
          "chapter": 2,
          "verse": 20,
          "section_title": "Sự sửa phạt người Canh-đê",
          "text": "Nhưng Đức Giê-hô-va ở trong đền thánh của Ngài, trước mặt Ngài, cả đất hãy làm thinh!",
          "cross_references": []
        }
      ]
    },
    {
      "chapter": 3,
      "total_verses": 19,
      "verses": [
        {
